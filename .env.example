# Copy this file to .env.local to change the backend address.
# The server uses BACKEND_URL for startup checks and for every account request.
BACKEND_URL=

# The address phones use to open a scanned attendance QR. Falls back to the request.
APP_URL=

# The chat socket address the browser connects to, for example wss://api.example.com/ws/chat.
# Falls back to BACKEND_URL with ws:// and /ws/chat, which only works when the browser can reach it.
CHAT_WS_URL=
