# Copy this file to .env.local to change the backend address.
# The server uses BACKEND_URL for startup checks and for every account request.
BACKEND_URL=

# Required. The same value as INTERNAL_API_KEY in the backend .env.
# Sent on every server-side call; the backend refuses calls without it. Never expose it to the browser.
INTERNAL_API_KEY=

# The address phones use to open a scanned attendance QR. Falls back to the request.
APP_URL=

# The realtime socket address the browser connects to, for example wss://api.example.com/ws.
# Falls back to CHAT_WS_URL (older name, its /ws/chat path still works), then to BACKEND_URL
# with ws:// and /ws, which only works when the browser can reach it.
REALTIME_WS_URL=
CHAT_WS_URL=
